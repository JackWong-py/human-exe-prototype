# The full version: builds the React app first, then serves it from the Python backend.
# To use it:  mv Dockerfile.vercel Dockerfile.vercel.backend-only  &&  mv Dockerfile.vercel.with-frontend Dockerfile.vercel

# ---- Stage 1: build the React app into /web/dist ----
FROM node:22-slim AS frontend
WORKDIR /web
COPY package.json package-lock.json ./
RUN npm ci
COPY index.html vite.config.js ./
COPY public ./public
COPY src ./src
RUN npm run build

# ---- Stage 2: the Python backend, which also serves the built React app ----
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends tesseract-ocr \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY contracts.py loader.py ./
COPY data ./data
COPY --from=frontend /web/dist ./dist

ENV DB_PATH=/tmp/sdoc.db \
    AUTO_RUN=1

CMD ["sh", "-c", "python -m uvicorn app.api:app --host 0.0.0.0 --port ${PORT:-80}"]
